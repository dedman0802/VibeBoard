# Supabase Postgres connection strings.
# Get these from Supabase dashboard: Project Settings > Database > Connection string.

# Pooled connection (port 6543, pgbouncer) - used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - used by Prisma CLI for migrate/introspect.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
